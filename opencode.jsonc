{
  "$schema": "https://opencode.ai/config.json",
  "lsp": {
    "pyright": {"disabled": true},
    "uv-pyright": {
      "extensions": [".py", ".pyi"],
      "command": ["uv", "run", "pyright-langserver",  "--stdio"]
    }
  },
  "model": "openrouter/openai/gpt-5.6-luna",
  "small_model": "openrouter/minimax/minimax-m3",
  "disabled_providers": ["github-copilot", "opencode"],
  "provider": {
    "openrouter": {
      "whitelist": [
        "openai/gpt-5.6-luna",
        "deepseek/deepseek-v4-flash-0731",
        "minimax/minimax-m3",
        "z-ai/glm-5.3-flash",
        "qwen/qwen3-coder-plus",
        "xiaomi/mimo-v2.5"
      ]
    }
  },
  "mode": {
    "build": {
      "temperature": 0.1
    },
    "plan": {
      "temperature": 0.1
    }
  },
  "permission": {
    "bash": {
      "git commit *": "deny",
      "git checkout *": "deny",
      "git reset *": "deny",
      "git rm*": "deny",
      "git cherry-pick *": "deny",
      "rm *": "deny",
      "rm scratch/*": "allow",
      "rm -r scratch/*": "allow",
      "rm -fr scratch/*": "allow"
    }
  },
  "mcp": {
    "ddg": {
      "type": "local",
      "command": ["uvx", "duckduckgo-mcp-server"],
      "enabled": true
    }
  }
}
